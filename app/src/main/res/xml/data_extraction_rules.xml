<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive database and preferences from cloud backup -->
        <exclude domain="database" path="meezan_database" />
        <exclude domain="sharedpref" path="com.example.meezan_preferences" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="meezan_database" />
        <include domain="sharedpref" path="com.example.meezan_preferences" />
    </device-transfer>
</data-extraction-rules>
